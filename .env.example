# Firebase Client SDK (safe to expose — restricted by Firebase Security Rules)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (server-side only — NEVER expose to client)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay Gateway (Phase 2)
# Public Key (Safe for client-side checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# Secret Key (Server-side ONLY - NEVER expose to client)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Webhook Secret (Server-side webhook payload verification)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
