rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'admin@apexerp.com' ||
        request.auth.token.email == 'tanushdemo@gmail.com'
      );
    }

    function isTeacher() {
      return isAuthenticated() && request.auth.token.role == 'teacher';
    }

    function isStudent() {
      return isAuthenticated() && request.auth.token.role == 'student';
    }

    function isParent() {
      return isAuthenticated() && request.auth.token.role == 'parent';
    }

    function isTeacherOf(batchId) {
      return isTeacher() && (
        request.auth.token.batchIds != null &&
        batchId in request.auth.token.batchIds
      );
    }

    function isStudentOf(batchId) {
      return isStudent() && (
        request.auth.token.batchId == batchId ||
        (request.auth.token.batchIds != null && batchId in request.auth.token.batchIds)
      );
    }

    function isOwnStudent(studentId) {
      return isStudent() && (
        request.auth.token.studentId == studentId ||
        request.auth.uid == studentId
      );
    }

    function isParentOf(studentId) {
      return isParent() && (
        request.auth.token.childIds != null &&
        studentId in request.auth.token.childIds
      );
    }

    function isValidFileSize() {
      return request.resource == null || request.resource.size < 50 * 1024 * 1024;
    }

    // Student profile photos and documents
    match /students/{studentId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        isOwnStudent(studentId) ||
        isParentOf(studentId)
      );
      allow write: if (isAdmin() || isOwnStudent(studentId)) && isValidFileSize();
    }

    // Teacher profile photos and documents
    match /teachers/{teacherId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if (isAdmin() || (isTeacher() && request.auth.uid == teacherId)) && isValidFileSize();
    }

    // Phase 5: Study materials (Primary path: studyMaterials/{batchId}/...)
    match /studyMaterials/{batchId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacherOf(batchId) ||
        isStudentOf(batchId) ||
        isParent()
      );
      allow write: if (isAdmin() || isTeacherOf(batchId)) && isValidFileSize();
    }

    // Legacy/Alternative Study materials path
    match /materials/{batchId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacherOf(batchId) ||
        isStudentOf(batchId) ||
        isParent()
      );
      allow write: if (isAdmin() || isTeacherOf(batchId)) && isValidFileSize();
    }

    // Homework & DPPs (Primary path: homework/{batchId}/...)
    match /homework/{batchId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacherOf(batchId) ||
        isStudentOf(batchId) ||
        isParent()
      );
      allow write: if (isAdmin() || isTeacherOf(batchId)) && isValidFileSize();
    }

    // Homework Submissions (Student uploads: homeworkSubmissions/{assignmentId}/{studentId}/...)
    match /homeworkSubmissions/{assignmentId}/{studentId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacher() ||
        isOwnStudent(studentId) ||
        isParentOf(studentId)
      );
      allow write: if (isAdmin() || isOwnStudent(studentId)) && isValidFileSize();
    }

    // Legacy Assignments path
    match /assignments/{batchId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isTeacherOf(batchId) ||
        isStudentOf(batchId) ||
        isParent()
      );
      allow write: if (isAdmin() || isTeacherOf(batchId)) && isValidFileSize();
    }

    // Fee Receipts
    match /receipts/{studentId}/{allPaths=**} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isOwnStudent(studentId) ||
        isParentOf(studentId)
      );
      allow write: if isAdmin() && isValidFileSize();
    }

    // General fallback: Authenticated can read public assets, Admin can write
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidFileSize();
    }
  }
}
